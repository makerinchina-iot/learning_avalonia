<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:dock_tutorial2.ViewModels"
             xmlns:view="using:dock_tutorial2.Views"
             x:Class="dock_tutorial2.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
  
    <Application.Styles>
        <FluentTheme />
        <DockFluentTheme/>
    </Application.Styles>
             
    <Application.DataTemplates>
        <DataTemplate x:DataType="vm:FileDocViewModel">
            <view:FileDocView></view:FileDocView>
        </DataTemplate>
        <DataTemplate x:DataType="vm:ImgDocViewModel">
            <view:ImgDocView></view:ImgDocView>
        </DataTemplate>
        <DataTemplate x:DataType="vm:FileMangerViewModel">
            <view:FileMangerView></view:FileMangerView>
        </DataTemplate>
    </Application.DataTemplates>
             
</Application>